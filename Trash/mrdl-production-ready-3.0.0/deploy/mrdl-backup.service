[Unit]
Description=Create a consistent MRDL backup
After=local-fs.target
ConditionPathExists=/var/lib/mrdl/model/mrdl.db

[Service]
Type=oneshot
User=mrdl
Group=mrdl
WorkingDirectory=/var/lib/mrdl
Environment=MRDL_BIN=/usr/local/bin/mrdl
ExecStart=/usr/local/libexec/mrdl-backup /etc/mrdl/mrdl.ini /var/backups/mrdl
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mrdl /var/backups/mrdl
UMask=0027
TimeoutStartSec=6h
