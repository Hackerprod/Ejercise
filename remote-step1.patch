--- /dev/null
+++ b/benchmarks/identity_transport_diagnostic.py
@@ -0,0 +1,173 @@
+"""Step 1 diagnostic: identity transport versus cosine operator baseline."""
+from __future__ import annotations
+
+import argparse
+import json
+import math
+import statistics
+import time
+from collections import Counter, defaultdict
+from dataclasses import asdict
+from pathlib import Path
+
+from mrdl.language import EmbeddingTable, MRDLLanguagePipeline, TrigramBaseline, load_tinystories, split_stories
+from benchmarks.language_generation import measure_vsa_cost
+
+
+class DiagnosticPipeline(MRDLLanguagePipeline):
+    """Capture final score-winner depth without changing pipeline behavior."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.collect_winner_diagnostics = False
+        self.winner_samples: list[tuple[int, float | None]] = []
+        self._current_winner: tuple[int, float | None] = (0, None)
+
+    def _scores(self, engine, seeds=()):
+        scores, active_ids = super()._scores(engine, seeds)
+        winner_depth = 0
+        winner_magnitude: float | None = None
+        if scores:
+            winner = max(scores, key=lambda item: (scores[item], item))
+            seen: set[str] = set()
+            for depth, frontier in enumerate(engine.round_frontiers, start=1):
+                for candidate in frontier:
+                    if candidate.node_id in seen:
+                        continue
+                    seen.add(candidate.node_id)
+                    if candidate.node_id == winner:
+                        winner_depth = depth
+                        winner_magnitude = max(math.ulp(1.0), abs(candidate.operator.apply(1.0)))
+                        break
+                if winner_depth:
+                    break
+        self._current_winner = (winner_depth, winner_magnitude)
+        return scores, active_ids
+
+    def predict(self, context):
+        self._current_winner = (0, None)
+        prediction = super().predict(context)
+        if self.collect_winner_diagnostics:
+            self.winner_samples.append(self._current_winner)
+        return prediction
+
+
+def paired_baseline(train, test):
+    baseline = TrigramBaseline()
+    baseline.train(train)
+    loss = 0.0
+    correct = 0
+    tokens = 0
+    for story in test:
+        context = ["<bos>"]
+        for target in story[1:]:
+            prediction = baseline.predict(context)
+            loss -= math.log(max(1e-9, prediction.probabilities.get(target, 1e-9)))
+            correct += prediction.token == target
+            tokens += 1
+            context.append(target)
+    return {"train_stories": len(train), "test_stories": len(test), "tokens": tokens, "loss": loss / max(1, tokens), "accuracy": correct / max(1, tokens)}
+
+
+def summarize_winners(samples: list[tuple[int, float | None]], depth: int) -> dict[str, object]:
+    counts = Counter(depth_value for depth_value, _ in samples)
+    magnitudes: dict[int, list[float]] = defaultdict(list)
+    for depth_value, magnitude in samples:
+        if magnitude is not None:
+            magnitudes[depth_value].append(magnitude)
+    by_depth = {}
+    for depth_value in range(depth + 1):
+        values = magnitudes.get(depth_value, [])
+        by_depth[str(depth_value)] = {"count": len(values), "mean": sum(values) / len(values) if values else None, "median": statistics.median(values) if values else None}
+    return {"winner_depth_counts": {str(depth_value): counts.get(depth_value, 0) for depth_value in range(depth + 1)}, "operator_magnitude_by_winner_depth": by_depth, "samples": len(samples)}
+
+
+def run_mode(stories, train, test, baseline, embedding_mode, transport_mode, args):
+    vocabulary = sorted({token for story in stories for token in story})
+    if embedding_mode == "pretrained_frozen":
+        embeddings = EmbeddingTable.from_frozen_file(vocabulary, args.pretrained_path, args.dimension, external_pretrained=str(args.pretrained_path).endswith(".gz"))
+    else:
+        embeddings = EmbeddingTable.random_frozen(vocabulary, args.dimension, args.seed)
+    start = time.perf_counter()
+    pipeline = DiagnosticPipeline(embeddings, args.beam, propagation_rounds=4, vsa_dimension=256, causal_probe_limit=4, transport_coefficient_mode=transport_mode)
+    pipeline.observe_training(train)
+    weights_before = tuple(pipeline.controller.weights)
+    controller_updates = pipeline.train_controller(train, max_steps=args.controller_steps, promotion_interval=args.promotion_interval, promotion_limit=args.promotion_limit, minimum_support=2)
+    pipeline.collect_winner_diagnostics = True
+    graph = pipeline.evaluate(test, "FULL")
+    pipeline.collect_winner_diagnostics = False
+    elapsed_ms = (time.perf_counter() - start) * 1000.0
+    vsa_cost = measure_vsa_cost(4096, args.seed)
+    return {
+        "embedding_mode": embedding_mode,
+        "transport_coefficient_mode": transport_mode,
+        "transport_identity": transport_mode == "identity",
+        "cosine_relation_retained_as_metadata": True,
+        "depth": 4,
+        "train_stories": len(train),
+        "test_stories": len(test),
+        "vocab_size": len(vocabulary),
+        "controller_updates": controller_updates,
+        "controller": {"signal_names": list(pipeline.controller.signal_names), "weights_before": list(weights_before), "weights_after": list(pipeline.controller.weights), "weights_changed": weights_before != tuple(pipeline.controller.weights), "active_m2_only": True},
+        "promoted_edges": pipeline.promoted_edges,
+        "causal_promotion": pipeline.causal_metrics,
+        "graph": asdict(graph),
+        "accuracy": graph.accuracy,
+        "loss": graph.loss,
+        "accuracy_vs_trigram": graph.accuracy - baseline["accuracy"],
+        "loss_vs_trigram": graph.loss - baseline["loss"],
+        "fallback": {"counts": dict(graph.fallback_counts), "fraction": graph.fallback_fraction},
+        "clean": {"health_ratio": graph.clean_health_ratio, "empty_fraction": graph.clean_empty_fraction},
+        "propagation": {"requested_depth": graph.requested_depth, "actual_round_counts": dict(graph.actual_round_counts), "stop_reason_counts": dict(graph.stop_reason_counts)},
+        "winner_diagnostics": summarize_winners(pipeline.winner_samples, 4),
+        "cost_ms": {"pipeline": elapsed_ms, "vsa_dimension_4096": vsa_cost, "vsa_to_pipeline_ratio": vsa_cost["total_ms"] / max(elapsed_ms, 1e-9)},
+    }
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--corpus", type=Path, default=Path("data/TinyStories-valid.txt"))
+    parser.add_argument("--pretrained-path", type=Path, default=Path("data/glove-wiki-gigaword-50.gz"))
+    parser.add_argument("--stories", type=int, default=257)
+    parser.add_argument("--max-tokens", type=int, default=4000)
+    parser.add_argument("--dimension", type=int, default=50)
+    parser.add_argument("--story-token-limit", type=int, default=12)
+    parser.add_argument("--seed", type=int, default=1729)
+    parser.add_argument("--beam", type=int, default=4)
+    parser.add_argument("--controller-steps", type=int, default=2048)
+    parser.add_argument("--promotion-interval", type=int, default=64)
+    parser.add_argument("--promotion-limit", type=int, default=128)
+    parser.add_argument("--output", type=Path, default=Path("results/identity_transport_diagnostic.json"))
+    args = parser.parse_args()
+    stories = load_tinystories(args.corpus, args.stories, args.max_tokens, args.story_token_limit)
+    train, test = split_stories(stories)
+    baseline = paired_baseline(train, test)
+    if len(stories) != 257 or len(train) != 205 or len(test) != 52 or baseline["tokens"] != 572:
+        raise AssertionError("exact paired protocol requires 257 stories, 205/52 split, and 572 test tokens")
+    rows = []
+    for embedding_mode in ("random_frozen", "pretrained_frozen"):
+        for transport_mode in ("cosine", "identity"):
+            rows.append(run_mode(stories, train, test, baseline, embedding_mode, transport_mode, args))
+    comparisons = {}
+    for embedding_mode in ("random_frozen", "pretrained_frozen"):
+        cosine = next(row for row in rows if row["embedding_mode"] == embedding_mode and row["transport_coefficient_mode"] == "cosine")
+        identity = next(row for row in rows if row["embedding_mode"] == embedding_mode and row["transport_coefficient_mode"] == "identity")
+        comparisons[embedding_mode] = {"cosine_accuracy": cosine["accuracy"], "identity_accuracy": identity["accuracy"], "identity_minus_cosine_accuracy": identity["accuracy"] - cosine["accuracy"], "cosine_loss": cosine["loss"], "identity_loss": identity["loss"], "identity_minus_cosine_loss": identity["loss"] - cosine["loss"]}
+    result = {
+        "diagnostic": "step1_identity_transport",
+        "scope": "EdgeMemory.lane_records coefficient only; no Step 2 rotations; no phase E",
+        "protocol": {"corpus": "TinyStories-valid.txt", "stories": len(stories), "train_stories": len(train), "test_stories": len(test), "test_tokens": baseline["tokens"], "depth": 4, "state": {"beam": args.beam, "dimension": args.dimension, "seed": args.seed, "vsa_dimension": 256, "controller_steps": args.controller_steps, "promotion_interval": args.promotion_interval, "promotion_limit": args.promotion_limit}, "same_pipeline": True},
+        "paired_baseline": baseline,
+        "side_by_side": rows,
+        "identity_vs_cosine": comparisons,
+        "phase_e_corpus_scaling_started": False,
+        "production_default_remains_cosine": True,
+    }
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(result, indent=2), encoding="utf-8")
+    print(json.dumps(result, indent=2))
+
+
+if __name__ == "__main__":
+    main()
+
