{
  "version": 6,
  "configurePresets": [
    {
      "name": "release-vps",
      "displayName": "Release for CPU VPS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MRDL_BUILD_TESTS": "ON",
        "MRDL_BUILD_BENCHMARKS": "ON",
        "MRDL_NATIVE_ARCH": "ON",
        "MRDL_ENABLE_LTO": "ON"
      }
    },
    {
      "name": "debug-sanitize",
      "displayName": "Debug with sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MRDL_BUILD_TESTS": "ON",
        "MRDL_BUILD_BENCHMARKS": "OFF",
        "MRDL_NATIVE_ARCH": "OFF",
        "MRDL_ENABLE_SANITIZERS": "ON",
        "MRDL_ENABLE_LTO": "OFF"
      }
    }
  ],
  "buildPresets": [
    {"name": "release-vps", "configurePreset": "release-vps"},
    {"name": "debug-sanitize", "configurePreset": "debug-sanitize"}
  ],
  "testPresets": [
    {"name": "release-vps", "configurePreset": "release-vps", "output": {"outputOnFailure": true}},
    {"name": "debug-sanitize", "configurePreset": "debug-sanitize", "output": {"outputOnFailure": true}}
  ]
}
