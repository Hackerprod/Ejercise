{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA R1 Scientific Scoping A Smoke Report",
  "type": "object",
  "required": ["schema", "campaign_id", "mode", "campaign_started", "runs", "classification", "source_hashes", "policy"],
  "properties": {
    "schema": {"const": "omega-core-lm-0-r1-scientific-scoping-a-smoke-report-v1"},
    "campaign_id": {"const": "OMEGA-CORE-LM-0-R1-SCIENTIFIC-SCOPING-A"},
    "mode": {"const": "smoke_only"},
    "campaign_started": {"const": false},
    "real_data_loaded": {"const": false},
    "fresh_process_resume": {"const": true},
    "append_only_segments": {"const": true},
    "runs": {"type": "array", "minItems": 2},
    "classification": {"type": "object", "required": ["per_seed_delta", "mean_delta", "classification"]},
    "source_hashes": {"type": "object"},
    "policy": {"type": "object"}
  }
}
