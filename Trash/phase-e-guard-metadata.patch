+    def test_stage_story_ceiling_preserves_default(self):
+        self.assertEqual(DEFAULT_STORY_COUNT, 5000)
+        self.assertEqual(MAX_STAGE_STORIES, 10000)
+        with self.assertRaisesRegex(ValueError, "bounded at 10000 stories"):
+            run_stage(type("Args", (), {"stories": MAX_STAGE_STORIES + 1})())
+
+    def test_ten_k_metadata_tracks_requested_run(self):
+        self.assertEqual(_not_run_metadata(True), ["phase_e_stage2"])
+        self.assertEqual(_not_run_metadata(False), ["phase_e_stage2", "10000_story_resume"])
+
+        def run_with(stories, output):
+            args = type("Args", (), {
+                "stories": stories,
+                "corpus": Path("corpus.txt"),
+                "pretrained_path": Path("vectors.gz"),
+                "story_token_limit": 8,
+                "split_seed": 1729,
+                "controller_steps": None,
+                "promotion_limit": None,
+                "promotion_interval": None,
+                "resource_root": Path("."),
+                "output": output,
+                "dimension": 50,
+                "seed": 1729,
+                "beam": 4,
+                "vsa_dimension": 8,
+            })()
+            record = {"story_id": "story", "source_index": stories - 1, "tokens": ["<bos>", "x", "<eos>"]}
+            with patch("benchmarks.phase_e_stage.load_stage_stories", return_value=[record]), \
+                    patch("benchmarks.phase_e_stage.split_stage_stories", return_value=(
+                        [["<bos>", "x", "<eos>"]], [["<bos>", "x", "<eos>"]],
+                        {"train_story_ids": ["train"], "test_story_ids": ["test"], "algorithm": "test", "split_seed": 1729},
+                    )), \
+                    patch("benchmarks.phase_e_stage.ResourceMonitor") as monitor_class, \
+                    patch("benchmarks.phase_e_stage.run_mode", return_value={}) as run_mode_mock, \
+                    patch("benchmarks.phase_e_stage.evaluate_trigram", return_value={}):
+                monitor_class.return_value.to_dict.return_value = {}
+                result = run_stage(args)
+            return result, run_mode_mock
+
+        with tempfile.TemporaryDirectory() as directory:
+            output = Path(directory) / "result.json"
+            result, run_mode_mock = run_with(MAX_STAGE_STORIES, output)
+            self.assertTrue(result["safety"]["ten_k_run"])
+            self.assertTrue(run_mode_mock.call_args.args[-1])
+            result, run_mode_mock = run_with(DEFAULT_STORY_COUNT, output)
+            self.assertFalse(result["safety"]["ten_k_run"])
+            self.assertFalse(run_mode_mock.call_args.args[-1])
+
