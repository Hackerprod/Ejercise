{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "er32-cost-gate-v1",
  "title": "OMEGA CORE-LM-0 ER32 integration and cost gate artifact",
  "type": "object",
  "required": [
    "schema",
    "artifact",
    "run_id",
    "source_sha256s",
    "git_commit",
    "python",
    "pytorch",
    "windows",
    "cpu_identity",
    "threads",
    "dataset_revision",
    "teacher_revision",
    "manifest_hash",
    "artifact_self_hash"
  ],
  "properties": {
    "schema": {"const": "er32-cost-gate-v1"},
    "artifact": {"enum": ["integration_report", "cost_report", "inference_report"]},
    "run_id": {"type": "string", "minLength": 1},
    "source_sha256s": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "git_commit": {"type": "string", "minLength": 1},
    "python": {"type": "string", "minLength": 1},
    "pytorch": {"type": "string", "minLength": 1},
    "windows": {"type": "string", "minLength": 1},
    "cpu_identity": {"type": "string"},
    "threads": {"type": "object"},
    "dataset_revision": {"type": "object", "required": ["revision", "split"]},
    "teacher_revision": {"type": "object", "required": ["revision"]},
    "manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_self_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string"},
    "global_status": {"enum": ["PASS", "FAIL"]},
    "gates": {"type": "object"}
  },
  "additionalProperties": true
}
