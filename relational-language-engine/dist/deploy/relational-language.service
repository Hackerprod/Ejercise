[Unit]
Description=Relational Language Engine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rlm
Group=rlm
WorkingDirectory=/opt/relational-language-engine
ExecStart=/opt/relational-language-engine/bin/rlmctl serve --config /opt/relational-language-engine/config/production.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/relational-language-engine/data /opt/relational-language-engine/log
MemoryMax=7G
TasksMax=128

[Install]
WantedBy=multi-user.target
