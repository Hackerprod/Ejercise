{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-release",
      "displayName": "Linux Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CNRL_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux Debug + ASan/UBSan",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CNRL_WARNINGS_AS_ERRORS": "ON",
        "CNRL_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "windows-ninja-release",
      "displayName": "Windows x64 Release (Ninja, active MSVC environment)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CNRL_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-vs2022-release",
      "displayName": "Windows x64 Release (Visual Studio 2022 compatibility)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-vs2022",
      "cacheVariables": {
        "CNRL_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja-release" },
    { "name": "windows-vs2022-release", "configurePreset": "windows-vs2022-release", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "linux-release", "configurePreset": "linux-release", "output": { "outputOnFailure": true } },
    { "name": "linux-asan", "configurePreset": "linux-asan", "output": { "outputOnFailure": true } },
    { "name": "windows-ninja-release", "configurePreset": "windows-ninja-release", "output": { "outputOnFailure": true } },
    { "name": "windows-vs2022-release", "configurePreset": "windows-vs2022-release", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
