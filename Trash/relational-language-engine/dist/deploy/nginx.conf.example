upstream relational_language_engine {
    server 127.0.0.1:9087;
    keepalive 16;
}
server {
    listen 443 ssl http2;
    server_name rlm.example.com;
    # ssl_certificate /etc/letsencrypt/live/rlm.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/rlm.example.com/privkey.pem;
    client_max_body_size 4m;
    location / {
        proxy_pass http://relational_language_engine;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }
}
