[Unit]
Description=MRDL escrow garbage collection
After=local-fs.target
ConditionPathExists=/var/lib/mrdl/model/mrdl.db

[Service]
Type=oneshot
User=mrdl
Group=mrdl
WorkingDirectory=/var/lib/mrdl
ExecStart=/usr/local/bin/mrdl gc --config /etc/mrdl/mrdl.ini --json
Nice=15
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mrdl
UMask=0027
TimeoutStartSec=2h
