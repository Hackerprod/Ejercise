{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OMEGA CORE LM 0 R1 CPU scoping report",
  "type": "object",
  "required": [
    "schema",
    "campaign",
    "status",
    "execution_order",
    "cpu_identity",
    "safety_boundary",
    "stage1_inference",
    "stage2_efficiency",
    "stage3_real_teacher",
    "stage3_compile_comparison",
    "stage4_scope_a_projection"
  ],
  "properties": {
    "schema": {"const": "omega-core-lm-0-r1-cpu-scoping-readiness-v2"},
    "execution_order": {"const": [1, 2, 3, "3-profile", "3-compile", 4]},
    "safety_boundary": {
      "type": "object",
      "required": ["device_requested", "gpu_used", "spend", "dtype", "bf16", "amp", "local_files_only"],
      "properties": {
        "device_requested": {"const": "cpu"},
        "gpu_used": {"const": false},
        "spend": {"const": false},
        "dtype": {"const": "float32"},
        "bf16": {"const": false},
        "amp": {"const": false},
        "local_files_only": {"const": true}
      }
    },
    "stage3_real_teacher": {
      "type": "object",
      "properties": {
        "updates_requested_per_variant": {"const": 4},
        "pairs_requested_per_variant": {"const": 2},
        "nll_interpretation": {"const": false}
      }
    },
    "stage3_compile_comparison": {
      "type": "object",
      "required": ["modes", "updates_per_variant_and_mode", "tolerance_policy", "mode_results", "equivalence_results"],
      "properties": {
        "modes": {"const": ["eager", "default", "max-autotune"]},
        "updates_per_variant_and_mode": {"const": 3},
        "tolerance_policy": {
          "type": "object",
          "required": ["absolute", "relax_after_results"],
          "properties": {
            "absolute": {"const": 0.00001},
            "relax_after_results": {"const": false}
          }
        }
      }
    },
    "stage4_scope_a_projection": {
      "type": "object",
      "properties": {
        "status": {"const": "projected_only"},
        "classification": {"const": "SCOPE_A_PROJECTION_NO_2000_UPDATE_RUN"}
      }
    }
  }
}
